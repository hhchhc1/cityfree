{"ok":true,"command":"asset","data":{"assets":[{"id":"2849341710594","name":"碎石地面","desc":"这是一块方形的碎石地面，表面散布着大小不一、形态各异的灰色与浅灰色石块，石块间夹杂着零星绿色小草。地面主体为浅棕色沙土质地，整体风格偏向卡通化的自然荒野风格。","preview":{"url":"https://p9-dy-hamlet-ugc-sign.byteimg.com/tos-cn-i-c2ox06qgwk/aigc_editor/2a2da8a68a99444594411859232c9192.png~tplv-c2ox06qgwk-image-256.png?rk3s=649a29f5&x-expires=1797241355&x-signature=YNL3R7RdJVmYPO6PtfvtkUtrGFo%3D","uri":"tos-cn-i-c2ox06qgwk/aigc_editor/2a2da8a68a99444594411859232c9192.png"},"resource":{"url":"https://lf3-hamlet-resource-sign.douyincdn.com/hamlet-ugc/aigc_editor/dev/unity/9838848015618.glb?x-expires=1797241355&x-signature=u3jIhg4vPQMZZvP2GIUB3cHR%2Bk0%3D","uri":"hamlet-ugc/aigc_editor/dev/unity/9838848015618.glb"},"resourceType":1,"dataType":1,"resourceUrls":[],"style":2,"shapeType":1,"categoryList":[2],"productCategoryList":[300],"module":1,"scale":{"x":1.062584415614438,"y":1.062584415614438,"z":1.062584415614438},"createTime":1777376058,"source":1,"resourceTaskId":"0","isFavorite":false,"capacity":"2198","faceCount":"1998","logicalCenter":{"x":-0.0303725004196167,"y":0,"z":0.0003274977207183838},"rigged":false,"createFrom":"Official","status":"Online","reviewStatus":"Approved","platformStatus":"Online","isPublish":true,"totalUsageCount":"14","totalFavoriteCount":"2"},{"id":"11728849936386","name":"地面冲击","desc":"该光效以中心明亮的蓝白色光点为核心，外围环绕着半透明的淡紫色环形光晕。大量长短不一的亮白色光刃与细碎光点从中心向四周发散，上方还萦绕着朦胧的暗蓝色雾状光霭。整体呈现出科幻感十足的能量涌动视觉效果。","preview":{"url":"https://p3-dy-hamlet-ugc-sign.byteimg.com/tos-cn-i-c2ox06qgwk/aigc_editor/a4f3485405a0400ea701a9dc1cd8d588.png~tplv-c2ox06qgwk-image-256.png?rk3s=649a29f5&x-expires=1797241355&x-signature=ChJCQ9QqtVi5D%2FnSMVkX6Z8FaLs%3D","uri":"tos-cn-i-c2ox06qgwk/aigc_editor/a4f3485405a0400ea701a9dc1cd8d588.png"},"resource":{"url":"https://lf26-hamlet-resource-sign.douyincdn.com/hamlet-ugc/aigc_editor/dev/unity/11380055053314.wprefab?x-expires=1797241355&x-signature=SjxRM%2F8g55zvUUvFAtUcCdd6M8c%3D","uri":"hamlet-ugc/aigc_editor/dev/unity/11380055