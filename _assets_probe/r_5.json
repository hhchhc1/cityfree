{"ok":true,"command":"asset","data":{"assets":[{"id":"9842634381058","name":"草莓人偶","desc":"该人偶整体造型圆润憨态，头戴带有绿色果蒂叶片、表面分布草莓籽凹点的红色草莓造型头套，脸部露出带红卷发、圆黑亮眼睛与粉腮红的软萌面庞。人偶身着印粉色花朵图案的红色短袖上衣与红色短裤，脚穿浅白小鞋，双臂平展呈可爱的站立姿态。整体材质呈现出光滑细腻的软胶质感，色彩鲜亮明快，风格童趣治愈。","preview":{"url":"https://p26-dy-hamlet-ugc-sign.byteimg.com/tos-cn-i-c2ox06qgwk/aigc_editor/549dee1c9e9246fe830eb80cd092cdfc.png~tplv-c2ox06qgwk-image-256.png?rk3s=649a29f5&x-expires=1797241376&x-signature=474qwkGAdM3TDsmOijxG6qxRHXs%3D","uri":"tos-cn-i-c2ox06qgwk/aigc_editor/549dee1c9e9246fe830eb80cd092cdfc.png"},"resource":{"url":"https://lf26-hamlet-resource-sign.douyincdn.com/hamlet-ugc/aigc_editor/dev/unity/9777277660674.glb?x-expires=1797241376&x-signature=MIHDsBqA8s4T%2BuxPaqK1KBGsdYQ%3D","uri":"hamlet-ugc/aigc_editor/dev/unity/9777277660674.glb"},"resourceType":1,"dataType":1,"groupTypes":[6],"resourceUrls":[],"style":6,"shapeType":1,"categoryList":[7],"productCategoryList":[303],"module":1,"scale":{"x":1,"y":1,"z":1},"createTime":1789879442,"source":5,"resourceTaskId":"0","isFavorite":false,"capacity":"15400","faceCount":"15000","logicalCenter":{"x":-0.0019381344318389893,"y":0,"z":0.011088430881500244},"rigged":true,"ownerUid":"1715672331068103","creatorNickname":"炽煊花卉","creatorAvatarUrl":"https://p3.douyinpic.com/aweme/100x100/aweme-avatar/tos-cn-avt-0015_cdc976f3a1e804d86d4211f7f9b6d418.jpeg?from=3782654143","internalCreatorUid":"1715672331068103","createFrom":"Official","status":"Online","reviewStatus":"Approved","platformStatus":"Online","isPublish":true,"totalUsageCount":"5","totalFavoriteCount":"1"},{"id":"9777277599746","name":"草莓与人","desc":"主体是一颗尺寸远大于小人的巨型草莓，整体呈饱满的心形轮廓，顶部带有星形排列的绿色萼片与直立果柄。草莓果身通体为亮红色，表面均匀分布着橙黄色的椭圆籽状凸起，造型圆润卡通。旁侧站立着比例迷你的人偶，身着白T恤、深紫长裤与白鞋，整体呈现出明快童趣的低多边形卡通风格。","preview":{"url":"https://p9-dy-hamlet-ugc-sign.byteimg.com/tos-cn-i-c2ox06qgwk/aigc_editor/0b36da0a1eb94992ac28593567142b86.png~tplv-c2ox06qgwk-image-256.png?rk3s=649a29f5&x-expires=1797241376&x-signature=hd%2FvpOuRQTIcIhtow9b840tiH6E%3D","uri":"tos-c